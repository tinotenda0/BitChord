<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork: the Surprise Me widget. A capsule like the 4×1 player's, sized the same
  height and centred in the row the same way, with the sparkle in a circle where
  the player puts the cover. The whole capsule is the button; the root stays
  transparent and unclickable so a tap beside it falls through to the home screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_surprise"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_pill_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_surprise_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="7dp"
        android:paddingRight="18dp">

        <ImageView
            android:layout_width="@dimen/widget_pill_art"
            android:layout_height="@dimen/widget_pill_art"
            android:background="@drawable/widget_surprise_disc"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_widget_surprise" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/surprise_me"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_surprise_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_surprise_idle"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
