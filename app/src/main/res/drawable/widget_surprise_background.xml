<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork: the Surprise Me widget's capsule. The Listen Now card's mesh colours as a
  gradient, since a RemoteViews can't animate a mesh; the radius clamps to a full
  capsule at any height, as widget_pill_background does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="200dp" />
    <gradient
        android:angle="0"
        android:centerColor="#FF8E54E9"
        android:endColor="#FF4776E6"
        android:startColor="#FFFF5E62" />
</shape>
